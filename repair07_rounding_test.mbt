// Independent truth generated by deep-repair07/generate-rounding-reference.py.

///|
test "repair07 independent Fraction rounding vectors through public APIs" {
  let cases : Array[(Array[String], UInt64?)] = [
    (["0.0"], Some(0x0000000000000000UL)),
    (["-0.0"], Some(0x0000000000000000UL)),
    (["5e-324", "5e-324", "5e-324"], Some(0x0000000000000003UL)),
    (["2.225073858507201e-308", "5e-324"], Some(0x0010000000000000UL)),
    (
      ["1.9999999999999998", "1.1102230246251565e-16"],
      Some(0x4000000000000000UL),
    ),
    (
      [
        "1.7976931348623153e+308", "1.1975041857208318e+292", "1.1975041857208318e+292",
        "1.1975041857208318e+292",
      ],
      Some(0x7fefffffffffffffUL),
    ),
    (
      ["1.7976931348623157e+308", "4.9896007738368e+291"],
      Some(0x7fefffffffffffffUL),
    ),
    (["1.7976931348623157e+308", "9.9792015476736e+291"], None),
    (["1.7976931348623157e+308", "5e-324"], Some(0x7fefffffffffffffUL)),
    (
      ["3.054936363499605e-151", "3.391660689521908e-167"],
      Some(0x20b0000000000000UL),
    ),
    (
      ["3.0549363634996054e-151", "3.391660689521908e-167"],
      Some(0x20b0000000000002UL),
    ),
    (["0.5", "5.551115123125783e-17"], Some(0x3fe0000000000000UL)),
    (
      ["0.5000000000000001", "5.551115123125783e-17"],
      Some(0x3fe0000000000002UL),
    ),
    (["1.0", "1.1102230246251565e-16"], Some(0x3ff0000000000000UL)),
    (
      ["1.0000000000000002", "1.1102230246251565e-16"],
      Some(0x3ff0000000000002UL),
    ),
    (["2.0", "2.220446049250313e-16"], Some(0x4000000000000000UL)),
    (
      ["2.0000000000000004", "2.220446049250313e-16"],
      Some(0x4000000000000002UL),
    ),
    (
      ["3.273390607896142e+150", "3.6341936214780345e+134"],
      Some(0x5f30000000000000UL),
    ),
    (
      ["3.2733906078961426e+150", "3.6341936214780345e+134"],
      Some(0x5f30000000000002UL),
    ),
    (
      ["8.98846567431158e+307", "9.9792015476736e+291"],
      Some(0x7fe0000000000000UL),
    ),
    (
      ["8.988465674311582e+307", "9.9792015476736e+291"],
      Some(0x7fe0000000000002UL),
    ),
    (["1.0", "1.0", "1e+16"], Some(0x4341c37937e08001UL)),
    (["1.0", "1e+16", "1.0"], Some(0x4341c37937e08001UL)),
    (["1e+16", "1.0", "1.0"], Some(0x4341c37937e08001UL)),
    (["5e-324", "1.1102230246251565e-16", "1.0"], Some(0x3ff0000000000001UL)),
    (["5e-324", "1.0", "1.1102230246251565e-16"], Some(0x3ff0000000000001UL)),
    (["1.1102230246251565e-16", "5e-324", "1.0"], Some(0x3ff0000000000001UL)),
    (["1.1102230246251565e-16", "1.0", "5e-324"], Some(0x3ff0000000000001UL)),
    (["1.0", "5e-324", "1.1102230246251565e-16"], Some(0x3ff0000000000001UL)),
    (["1.0", "1.1102230246251565e-16", "5e-324"], Some(0x3ff0000000000001UL)),
  ]
  for (values, expected_bits) in cases {
    let mut text = "A:" + values[0]
    for i = 1; i < values.length(); i = i + 1 {
      text = "(" + text + "):" + values[i]
    }
    let t = read("(" + text + ",B:0);")
    match expected_bits {
      None => {
        assert_true(
          t.patristic_distance("A", "B") is Err(@phylo.NumericOverflow),
        )
        assert_true(t.patristic_matrix() is Err(@phylo.NumericOverflow))
        assert_true(t.prune(["A", "B"]) is Err(@phylo.NumericOverflow))
        assert_true(t.midpoint_root() is Err(@phylo.NumericOverflow))
      }
      Some(bits) => {
        let expected = bits.reinterpret_as_double()
        assert_eq(t.patristic_distance("A", "B"), Ok(expected))
        assert_eq(t.patristic_distance("B", "A"), Ok(expected))
        assert_eq(t.patristic_matrix().unwrap().values, [
          [0.0, expected],
          [expected, 0.0],
        ])
        let q = t.prune(["A", "B"]).unwrap()
        assert_eq(q.tree.patristic_distance("A", "B"), Ok(expected))
      }
    }
  }
}
