// Generated by implementation-03/reference/generate.py from independent oracles.

///|
test "oracle RF root-matters" {
  let a = read("((A,B),(C,D));")
  let b = read("(A,(B,(C,D)));")
  let r = a.rf_distance_rooted(b).unwrap()
  assert_eq(r.distance, 2)
  assert_eq(r.shared, [["C", "D"]])
  assert_eq(r.only_left, [["A", "B"]])
  assert_eq(r.only_right, [["B", "C", "D"]])
  let r = a.rf_distance_unrooted(b).unwrap()
  assert_eq(r.distance, 0)
  assert_eq(r.shared, [["C", "D"]])
  assert_eq(r.only_left, [])
  assert_eq(r.only_right, [])
}

///|
test "oracle RF rotation" {
  let a = read("((A,B),(C,D));")
  let b = read("((D,C),(B,A));")
  let r = a.rf_distance_rooted(b).unwrap()
  assert_eq(r.distance, 0)
  assert_eq(r.shared, [["A", "B"], ["C", "D"]])
  assert_eq(r.only_left, [])
  assert_eq(r.only_right, [])
  let r = a.rf_distance_unrooted(b).unwrap()
  assert_eq(r.distance, 0)
  assert_eq(r.shared, [["C", "D"]])
  assert_eq(r.only_left, [])
  assert_eq(r.only_right, [])
}

///|
test "oracle RF different-quartet" {
  let a = read("((A,B),(C,D));")
  let b = read("((A,C),(B,D));")
  let r = a.rf_distance_rooted(b).unwrap()
  assert_eq(r.distance, 4)
  assert_eq(r.shared, [])
  assert_eq(r.only_left, [["A", "B"], ["C", "D"]])
  assert_eq(r.only_right, [["A", "C"], ["B", "D"]])
  let r = a.rf_distance_unrooted(b).unwrap()
  assert_eq(r.distance, 2)
  assert_eq(r.shared, [])
  assert_eq(r.only_left, [["C", "D"]])
  assert_eq(r.only_right, [["B", "D"]])
}

///|
test "oracle RF lexical-not-shortlex" {
  let a = read("(('A_long',B),(C,D));")
  let b = read("(('A_long',C),(B,D));")
  let r = a.rf_distance_rooted(b).unwrap()
  assert_eq(r.distance, 4)
  assert_eq(r.shared, [])
  assert_eq(r.only_left, [["A_long", "B"], ["C", "D"]])
  assert_eq(r.only_right, [["A_long", "C"], ["B", "D"]])
  let r = a.rf_distance_unrooted(b).unwrap()
  assert_eq(r.distance, 2)
  assert_eq(r.shared, [])
  assert_eq(r.only_left, [["C", "D"]])
  assert_eq(r.only_right, [["B", "D"]])
}

///|
test "oracle RF unresolved" {
  let a = read("(A,B,C,D);")
  let b = read("((A,B),(C,D));")
  let r = a.rf_distance_rooted(b).unwrap()
  assert_eq(r.distance, 2)
  assert_eq(r.shared, [])
  assert_eq(r.only_left, [])
  assert_eq(r.only_right, [["A", "B"], ["C", "D"]])
  let r = a.rf_distance_unrooted(b).unwrap()
  assert_eq(r.distance, 1)
  assert_eq(r.shared, [])
  assert_eq(r.only_left, [])
  assert_eq(r.only_right, [["C", "D"]])
}

