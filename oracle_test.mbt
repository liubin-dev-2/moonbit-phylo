test "oracle distances transforms 0" {
  let t = read("((A:1,B:2):3,(C:4,D:5):6):99;")
  let reroot = t.midpoint_root().unwrap()
  assert_eq(t.rf_distance_unrooted(reroot.tree).unwrap().distance, 0)
  let pruned = t.prune(["A", "C"]).unwrap()
  assert_eq(pruned.tree.taxa(), ["A", "C"])
  check_mapping(t, reroot)
  check_mapping(t, pruned)
  near(t.patristic_distance("A", "A").unwrap(), 0)
  near(reroot.tree.patristic_distance("A", "A").unwrap(), 0)
  near(pruned.tree.patristic_distance("A", "A").unwrap(), 0)
  near(t.patristic_distance("A", "B").unwrap(), 3.0)
