test "oracle distances transforms 2" {
  let t = read("((A:0.1,B:0.2):0.3,C:0.4);")
  let reroot = t.midpoint_root().unwrap()
  assert_eq(t.rf_distance_unrooted(reroot.tree).unwrap().distance, 0)
  let pruned = t.prune(["A", "C"]).unwrap()
  assert_eq(pruned.tree.taxa(), ["A", "C"])
  check_mapping(t, reroot)
  check_mapping(t, pruned)
  near(t.patristic_distance("A", "A").unwrap(), 0)
  near(reroot.tree.patristic_distance("A", "A").unwrap(), 0)
  near(pruned.tree.patristic_distance("A", "A").unwrap(), 0)
  near(t.patristic_distance("A", "B").unwrap(), 0.30000000000000004)
  near(reroot.tree.patristic_distance("A", "B").unwrap(), 0.30000000000000004)
  near(t.patristic_distance("A", "C").unwrap(), 0.8)
  near(reroot.tree.patristic_distance("A", "C").unwrap(), 0.8)
  near(pruned.tree.patristic_distance("A", "C").unwrap(), 0.8)
  near(t.patristic_distance("B", "A").unwrap(), 0.30000000000000004)
  near(reroot.tree.patristic_distance("B", "A").unwrap(), 0.30000000000000004)
  near(t.patristic_distance("B", "B").unwrap(), 0)
  near(reroot.tree.patristic_distance("B", "B").unwrap(), 0)
  near(t.patristic_distance("B", "C").unwrap(), 0.9)
  near(reroot.tree.patristic_distance("B", "C").unwrap(), 0.8999999999999999)
  near(t.patristic_distance("C", "A").unwrap(), 0.8)
  near(reroot.tree.patristic_distance("C", "A").unwrap(), 0.8)
  near(pruned.tree.patristic_distance("C", "A").unwrap(), 0.8)
  near(t.patristic_distance("C", "B").unwrap(), 0.9)
  near(reroot.tree.patristic_distance("C", "B").unwrap(), 0.8999999999999999)
  near(t.patristic_distance("C", "C").unwrap(), 0)
  near(reroot.tree.patristic_distance("C", "C").unwrap(), 0)
  near(pruned.tree.patristic_distance("C", "C").unwrap(), 0)
}

