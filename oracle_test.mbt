    "Tubuca_rhizophorae": '1',
    "Tubuca_rosea": '?',
    "Tubuca_signata": '1',
    "Uca_maracoani": '0',
    "Uca_ornata": '?',
    "Uca_princeps": '0',
    "Xeruca_formosensis": '1',
  }
  let r = t.fitch_parsimony(traits).unwrap()
  assert_eq(r.score, 11)
  assert_eq(r.changed_edges.length(), r.score)
  check_assignment(t, r)
  check_observations(t, r, traits)
}

