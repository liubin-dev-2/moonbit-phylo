///|
test "repair08 half-unit offset rounding against independent Fraction vectors" {
  let cases : Array[(Array[Double], UInt64)] = [
    ([0x0000000000000000UL.reinterpret_as_double()], 0x0000000000000000UL),
    ([0x8000000000000000UL.reinterpret_as_double()], 0x0000000000000000UL),
    (
      [
        0x0000000000000001UL.reinterpret_as_double(),
        0x0000000000000001UL.reinterpret_as_double(),
        0x0000000000000001UL.reinterpret_as_double(),
      ],
      0x0000000000000002UL,
    ),
    (
      [
        0x000fffffffffffffUL.reinterpret_as_double(),
        0x0000000000000001UL.reinterpret_as_double(),
      ],
      0x0008000000000000UL,
    ),
    (
      [
        0x3fffffffffffffffUL.reinterpret_as_double(),
        0x3ca0000000000000UL.reinterpret_as_double(),
      ],
      0x3ff0000000000000UL,
    ),
    (
      [
        0x7feffffffffffffdUL.reinterpret_as_double(),
        0x7c93333333333333UL.reinterpret_as_double(),
        0x7c93333333333333UL.reinterpret_as_double(),
        0x7c93333333333333UL.reinterpret_as_double(),
      ],
      0x7fdfffffffffffffUL,
    ),
    (
      [
        0x7fefffffffffffffUL.reinterpret_as_double(),
        0x7c80000000000000UL.reinterpret_as_double(),
      ],
      0x7fdfffffffffffffUL,
    ),
    (
      [
        0x7fefffffffffffffUL.reinterpret_as_double(),
        0x7c90000000000000UL.reinterpret_as_double(),
      ],
      0x7fe0000000000000UL,
    ),
    (
      [
        0x7fefffffffffffffUL.reinterpret_as_double(),
        0x0000000000000001UL.reinterpret_as_double(),
      ],
      0x7fdfffffffffffffUL,
    ),
    (
      [
        0x20b0000000000000UL.reinterpret_as_double(),
        0x1d60000000000000UL.reinterpret_as_double(),
      ],
      0x20a0000000000000UL,
    ),
    (
      [
        0x20b0000000000001UL.reinterpret_as_double(),
        0x1d60000000000000UL.reinterpret_as_double(),
      ],
      0x20a0000000000002UL,
    ),
    (
      [
        0x3fe0000000000000UL.reinterpret_as_double(),
        0x3c90000000000000UL.reinterpret_as_double(),
      ],
      0x3fd0000000000000UL,
    ),
    (
      [
        0x3fe0000000000001UL.reinterpret_as_double(),
        0x3c90000000000000UL.reinterpret_as_double(),
      ],
      0x3fd0000000000002UL,
    ),
    (
      [
        0x3ff0000000000000UL.reinterpret_as_double(),
        0x3ca0000000000000UL.reinterpret_as_double(),
      ],
      0x3fe0000000000000UL,
    ),
    (
      [
        0x3ff0000000000001UL.reinterpret_as_double(),
        0x3ca0000000000000UL.reinterpret_as_double(),
      ],
      0x3fe0000000000002UL,
    ),
    (
      [
        0x4000000000000000UL.reinterpret_as_double(),
        0x3cb0000000000000UL.reinterpret_as_double(),
      ],
      0x3ff0000000000000UL,
    ),
    (
      [
        0x4000000000000001UL.reinterpret_as_double(),
        0x3cb0000000000000UL.reinterpret_as_double(),
      ],
      0x3ff0000000000002UL,
    ),
    (
      [
        0x5f30000000000000UL.reinterpret_as_double(),
        0x5be0000000000000UL.reinterpret_as_double(),
      ],
      0x5f20000000000000UL,
    ),
    (
      [
        0x5f30000000000001UL.reinterpret_as_double(),
        0x5be0000000000000UL.reinterpret_as_double(),
      ],
      0x5f20000000000002UL,
    ),
    (
      [
        0x7fe0000000000000UL.reinterpret_as_double(),
        0x7c90000000000000UL.reinterpret_as_double(),
      ],
      0x7fd0000000000000UL,
    ),
    (
      [
        0x7fe0000000000001UL.reinterpret_as_double(),
        0x7c90000000000000UL.reinterpret_as_double(),
      ],
      0x7fd0000000000002UL,
    ),
    (
      [
        0x3ff0000000000000UL.reinterpret_as_double(),
        0x3ff0000000000000UL.reinterpret_as_double(),
        0x4341c37937e08000UL.reinterpret_as_double(),
      ],
      0x4331c37937e08001UL,
    ),
    (
      [
        0x3ff0000000000000UL.reinterpret_as_double(),
        0x4341c37937e08000UL.reinterpret_as_double(),
        0x3ff0000000000000UL.reinterpret_as_double(),
      ],
      0x4331c37937e08001UL,
    ),
    (
      [
        0x4341c37937e08000UL.reinterpret_as_double(),
        0x3ff0000000000000UL.reinterpret_as_double(),
        0x3ff0000000000000UL.reinterpret_as_double(),
      ],
      0x4331c37937e08001UL,
    ),
    (
      [
        0x0000000000000001UL.reinterpret_as_double(),
        0x3ca0000000000000UL.reinterpret_as_double(),
        0x3ff0000000000000UL.reinterpret_as_double(),
      ],
      0x3fe0000000000001UL,
    ),
    (
      [
        0x0000000000000001UL.reinterpret_as_double(),
        0x3ff0000000000000UL.reinterpret_as_double(),
        0x3ca0000000000000UL.reinterpret_as_double(),
      ],
      0x3fe0000000000001UL,
    ),
    (
      [
        0x3ca0000000000000UL.reinterpret_as_double(),
        0x0000000000000001UL.reinterpret_as_double(),
        0x3ff0000000000000UL.reinterpret_as_double(),
      ],
      0x3fe0000000000001UL,
    ),
    (
      [
        0x3ca0000000000000UL.reinterpret_as_double(),
        0x3ff0000000000000UL.reinterpret_as_double(),
        0x0000000000000001UL.reinterpret_as_double(),
      ],
      0x3fe0000000000001UL,
    ),
    (
      [
        0x3ff0000000000000UL.reinterpret_as_double(),
        0x0000000000000001UL.reinterpret_as_double(),
        0x3ca0000000000000UL.reinterpret_as_double(),
      ],
      0x3fe0000000000001UL,
    ),
    (
      [
        0x3ff0000000000000UL.reinterpret_as_double(),
        0x3ca0000000000000UL.reinterpret_as_double(),
        0x0000000000000001UL.reinterpret_as_double(),
      ],
      0x3fe0000000000001UL,
    ),
    ([0x0000000000000001UL.reinterpret_as_double()], 0x0000000000000000UL),
    ([0x0000000000000005UL.reinterpret_as_double()], 0x0000000000000002UL),
  ]
  for (values, expected) in cases {
    let mut total = @bigint.BigInt::from_int(0)
    for value in values {
      total = total + length_units(value)
    }
    assert_eq(rounded_half_length(total).reinterpret_as_uint64(), expected)
  }
}
