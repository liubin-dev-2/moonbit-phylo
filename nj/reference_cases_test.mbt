// Generated by verification/nj_reference.py --generate from fixed Biopython 1.88.

///|
test "Biopython 1.88 five_additive paths and unrooted split" {
  let report = @nj.from_json(
    "{\"taxa\":[\"A\",\"B\",\"C\",\"D\",\"E\"],\"values\":[[0.0,5.0,20.0,29.0,30.0],[5.0,0.0,21.0,30.0,31.0],[20.0,21.0,0.0,19.0,20.0],[29.0,30.0,19.0,0.0,13.0],[30.0,31.0,20.0,13.0,0.0]]}",
  ).unwrap()
  let reference = @phylo.PhyloTree::from_newick(
    "[&U]((('A':2,'B':3):13,'C':5):8,'D':6,'E':7):0;",
  ).unwrap()
  assert_eq(report.tree.rf_distance_unrooted(reference).unwrap().distance, 0)
  let expected : Array[Array[Double]] = [
    [0, 5.0, 20.0, 29.0, 30.0],
    [5.0, 0, 21.0, 30.0, 31.0],
    [20.0, 21.0, 0, 19.0, 20.0],
    [29.0, 30.0, 19.0, 0, 13.0],
    [30.0, 31.0, 20.0, 13.0, 0],
  ]
  for i = 0; i < 5; i = i + 1 {
    for j = i + 1; j < 5; j = j + 1 {
      near(report.fitted.values[i][j], expected[i][j])
    }
  }
}

///|
test "Biopython 1.88 five_noisy paths and unrooted split" {
  let report = @nj.from_json(
    "{\"taxa\":[\"A\",\"B\",\"C\",\"D\",\"E\"],\"values\":[[0.0,5.0,20.5,29.0,30.0],[5.0,0.0,21.0,30.0,30.75],[20.5,21.0,0.0,19.375,20.0],[29.0,30.0,19.375,0.0,13.0],[30.0,30.75,20.0,13.0,0.0]]}",
  ).unwrap()
  let reference = @phylo.PhyloTree::from_newick(
    "[&U]((('A':2.1250000000000018,'B':2.8749999999999982):13,'C':5.25):7.9375,'D':6.125,'E':6.875):0;",
  ).unwrap()
  assert_eq(report.tree.rf_distance_unrooted(reference).unwrap().distance, 0)
  let expected : Array[Array[Double]] = [
    [0, 5.0, 20.375, 29.1875, 29.9375],
    [5.0, 0, 21.125, 29.9375, 30.6875],
    [20.375, 21.125, 0, 19.3125, 20.0625],
    [29.1875, 29.9375, 19.3125, 0, 13.0],
    [29.9375, 30.6875, 20.0625, 13.0, 0],
  ]
  for i = 0; i < 5; i = i + 1 {
    for j = i + 1; j < 5; j = j + 1 {
      near(report.fitted.values[i][j], expected[i][j])
    }
  }
}

///|
test "Biopython 1.88 five_fractional paths and unrooted split" {
  let report = @nj.from_json(
    "{\"taxa\":[\"A\",\"B\",\"C\",\"D\",\"E\"],\"values\":[[0.0,2.0,11.0,10.0,10.0],[2.0,0.0,10.0,10.0,10.0],[11.0,10.0,0.0,10.0,10.0],[10.0,10.0,10.0,0.0,8.0],[10.0,10.0,10.0,8.0,0.0]]}",
  ).unwrap()
  let reference = @phylo.PhyloTree::from_newick(
    "[&U]((('A':1.166666666666667,'B':0.83333333333333304):4.25,'C':5.25):0.75,'D':4,'E':4):0;",
  ).unwrap()
  assert_eq(report.tree.rf_distance_unrooted(reference).unwrap().distance, 0)
  let expected : Array[Array[Double]] = [
    [0, 2.0, 10.666666666666668, 10.166666666666668, 10.166666666666668],
    [2.0, 0, 10.333333333333332, 9.833333333333332, 9.833333333333332],
    [10.666666666666668, 10.333333333333332, 0, 10.0, 10.0],
    [10.166666666666668, 9.833333333333332, 10.0, 0, 8.0],
    [10.166666666666668, 9.833333333333332, 10.0, 8.0, 0],
  ]
  for i = 0; i < 5; i = i + 1 {
    for j = i + 1; j < 5; j = j + 1 {
      near(report.fitted.values[i][j], expected[i][j])
    }
  }
}
